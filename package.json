{
  "name": "xiangxiang-english",
  "version": "0.0.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node tools/build-static.mjs",
    "dev": "wrangler dev --config wrangler.jsonc --ip 0.0.0.0",
